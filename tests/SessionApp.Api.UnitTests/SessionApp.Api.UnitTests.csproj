    <RootNamespace>SessionApp.Api.UnitTests</RootNamespace>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <!-- DefaultHttpContext, used to exercise the request-parsing helpers. -->
