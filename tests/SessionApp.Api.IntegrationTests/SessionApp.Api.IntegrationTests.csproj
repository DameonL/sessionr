<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>SessionApp.Api.IntegrationTests</RootNamespace>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
    <PackageReference Include="xunit.v3" Version="3.2.2" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.4" />
    <PackageReference Include="Testcontainers" Version="4.14.0" />
  </ItemGroup>

  <!--
    References both Functions apps so the tests can construct the real Function classes
    (e.g. new Functions.Repertoire.Get(db)) rather than re-implementing their query code.
    The apps are OutputType=Exe; ReferenceOutputAssembly is fine, we only need their types.
  -->
  <ItemGroup>
    <ProjectReference Include="../../api/Shared/SessionApp.Api.Shared.csproj" />
    <ProjectReference Include="../SessionApp.Api.TestSupport/SessionApp.Api.TestSupport.csproj" />
    <!--
      The two apps mirror each other's namespaces, so a few Function classes (notably
      Groups.ByGroupId.Get) have identical fully-qualified names in both. "global" keeps them
      reachable unqualified as before; the extra alias lets a test name one specifically.
    -->
    <ProjectReference Include="../../api/Private/SessionApp.Api.Private.csproj" Aliases="global,privateapi" />
    <ProjectReference Include="../../api/Public/SessionApp.Api.Public.csproj" Aliases="global,publicapi" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

</Project>
