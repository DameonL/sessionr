            "text": ":root{color-scheme:dark;--bg:#121212;--surface:#1e1e1e;--surface-2:#2a2a2a;--text:#ffffff;--muted:#9e9e9e;--accent:#4dd0a5;--danger:#ef6461;--rust:#e0a458;--learning:#6db3f2;--border:#3a3a3a;--sheet-paper:#262626;--sheet-ink:#f2f2f2}@media (prefers-color-scheme:light){:root{color-scheme:light;--bg:#f5f4f2;--surface:#ffffff;--surface-2:#eceae7;--text:#1a1a1a;--muted:#62605c;--accent:#0e8f6f;--danger:#c0392b;--rust:#a3651f;--learning:#2a6fb0;--border:#d8d5d0;--sheet-paper:#ffffff;--sheet-ink:#000000}}*{box-sizing:border-box}body{margin:0;background:var(--bg);color:var(--text);font-family:system-ui,-apple-system,Segoe UI,Roboto,sans-serif;min-height:100dvh}a{color:var(--accent)}h1{font-size:1.4rem}h2{font-size:1.05rem;margin:1.25rem 0 .5rem}button{background:var(--surface-2);color:var(--text);border:1px solid var(--border);border-radius:6px;padding:.45rem .8rem;font-size:.95rem;cursor:pointer}button:disabled{opacity:.5}button.danger{color:var(--danger);border-color:var(--danger)}input,select{background:var(--surface-2);color:var(--text);border:1px solid var(--border);border-radius:6px;padding:.45rem;font-size:1rem}label{display:flex;flex-direction:column;gap:.25rem;font-size:.85rem;color:var(--muted)}.app-header{position:-webkit-sticky;position:sticky;top:0;z-index:100;background:rgba(18,24,38,.88);border-bottom:1px solid rgba(255,255,255,.08);backdrop-filter:blur(16px);-webkit-backdrop-filter:blur(16px)}.nav-container{justify-content:space-between;max-width:72rem;margin:0 auto;padding:.6rem 1.5rem;gap:1.5rem}.nav-brand,.nav-container{display:flex;align-items:center}.nav-brand{gap:.5rem;text-decoration:none;font-size:1.35rem;font-weight:800;letter-spacing:-.03em}.brand-icon{font-size:1.4rem}.brand-text{background:linear-gradient(135deg,var(--accent) 0,#60a5fa 100%);-webkit-background-clip:text;-webkit-text-fill-color:transparent}.desktop-nav{display:flex;align-items:center;gap:.35rem;background:rgba(255,255,255,.03);padding:.25rem;border-radius:9999px;border:1px solid rgba(255,255,255,.06)}.nav-pill{display:inline-flex;align-items:center;gap:.45rem;padding:.45rem .85rem;border-radius:9999px;text-decoration:none;font-size:.88rem;font-weight:500;color:var(--muted);transition:all .18s ease}.nav-pill:hover{color:var(--text);background:rgba(255,255,255,.06)}.nav-pill.active{color:var(--accent);background:rgba(77,208,165,.15);font-weight:600;box-shadow:0 0 12px rgba(77,208,165,.18)}.nav-icon{font-size:.95rem}.desktop-auth-slot{display:flex;align-items:center}.user-profile-badge{display:inline-flex;align-items:center;gap:.6rem;padding:.3rem .6rem .3rem .4rem;background:rgba(255,255,255,.04);border:1px solid rgba(255,255,255,.08);border-radius:9999px}.user-avatar{width:1.75rem;height:1.75rem;border-radius:50%;background:var(--accent);color:#0f172a;font-weight:700;font-size:.8rem;display:flex;align-items:center;justify-content:center}.user-name{font-size:.85rem;font-weight:500;color:var(--text);max-width:120px;overflow:hidden;text-overflow:ellipsis;white-space:nowrap}.btn-sm{padding:.2rem .5rem!important;font-size:.75rem!important;height:auto!important;border-radius:9999px!important}.hamburger-btn{display:none;flex-direction:column;justify-content:space-around;width:2rem;height:2rem;background:transparent;border:none;cursor:pointer;padding:0;z-index:102}.hamburger-btn .bar{width:1.75rem;height:2px;background:var(--text);border-radius:2px;transition:all .25s cubic-bezier(.4,0,.2,1)}.hamburger-btn.open .bar:first-child{transform:translateY(7px) rotate(45deg)}.hamburger-btn.open .bar:nth-child(2){opacity:0;transform:translateX(-10px)}.hamburger-btn.open .bar:nth-child(3){transform:translateY(-7px) rotate(-45deg)}.mobile-backdrop{position:fixed;inset:0;background:rgba(0,0,0,.5);-webkit-backdrop-filter:blur(4px);backdrop-filter:blur(4px);z-index:98}.mobile-drawer{position:absolute;top:100%;left:0;right:0;background:var(--surface-2);border-bottom:1px solid var(--border);padding:1rem;z-index:99;box-shadow:0 10px 25px -5px rgba(0,0,0,.5);animation:slideDownMenu .2s cubic-bezier(.16,1,.3,1) forwards}@keyframes slideDownMenu{0%{opacity:0;transform:translateY(-8px)}to{opacity:1;transform:translateY(0)}}.mobile-nav-links{display:flex;flex-direction:column;gap:.5rem}.mobile-nav-item{display:flex;align-items:center;gap:.75rem;padding:.75rem 1rem;border-radius:8px;text-decoration:none;color:var(--text);font-weight:500;background:var(--surface-3);transition:all .15s ease}.mobile-nav-item.active,.mobile-nav-item:hover{background:rgba(77,208,165,.15);color:var(--accent);font-weight:600}.mobile-auth-section{margin-top:.5rem;padding-top:.75rem;border-top:1px solid var(--border);display:flex;justify-content:flex-end}@media (max-width:767px){.desktop-auth-slot,.desktop-nav{display:none}.hamburger-btn{display:flex}}main{padding:1rem;max-width:42rem;margin:0 auto}.sheet-music{background:var(--sheet-paper);color:var(--sheet-ink);border-radius:8px;padding:.5rem;margin:.5rem 0}.sheet-music .highlight{fill:var(--accent)}.search-box{width:100%;margin-bottom:1rem;font-size:1.05rem}.card{background:var(--surface);border-radius:8px;margin-bottom:.5rem;padding:.25rem}.tune-list{list-style:none;margin:0;padding:0}.tune-row{display:flex;align-items:center;gap:.6rem;width:100%;padding:.6rem;background:none;border:none;text-align:left;font-size:1rem}.tune-row.selected{outline:1px solid var(--accent);border-radius:6px}.tune-title{flex:1 1;min-width:0;overflow:hidden;text-overflow:ellipsis;white-space:nowrap}.tune-meta{font-size:.85rem}.badge,.tune-meta{color:var(--muted)}.badge{font-size:.7rem;text-transform:uppercase;letter-spacing:.04em;padding:.15rem .5rem;border-radius:999px;background:var(--surface-2)}.badge-active{color:var(--accent)}.badge-learning{color:var(--learning)}.badge-rusty{color:var(--rust)}.badge-retired,.badge-wishlist{color:var(--muted)}.badge-queue{display:inline-block;color:var(--rust);margin:.25rem 0}.tune-detail{padding:.6rem;border-top:1px solid var(--border)}.quiet-link,a.tune-row{color:inh