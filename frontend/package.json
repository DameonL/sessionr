{
  "name": "frontend",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite --port 5173",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "generate-pwa-assets": "pwa-assets-generator --override && cp assets-src/icon-192x192.png assets-src/icon-512x512.png assets-src/maskable-icon-512x512.png assets-src/apple-touch-icon.png public/ && rm -f assets-src/icon-192x192.png assets-src/icon-512x512.png assets-src/maskable-icon-512x512.png assets-src/apple-touch-icon.png",
    "harness": "vite --port 5199 --strictPort",
    "harness:e2e": "node harness/e2e/startSync.mjs 20 && node harness/e2e/cursorSync.mjs"
  },
  "dependencies": {
    "@azure/msal-browser": "^5.17.3",
    "@azure/msal-react": "^5.5.3",
    "@tanstack/react-query": "^5.101.2",
    "@types/qrcode": "^1.5.6",
    "@vitejs/plugin-react": "^6.0.5",
    "abcjs": "^6.6.4",
    "jsqr": "^1.4.0",
    "qrcode": "^1.5.4",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-router-dom": "^7.18.2",
    "vite": "^8.2.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@types/node": "^20.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vite-pwa/assets-generator": "^1.0.2",
    "jsdom": "^29.1.1",
    "typescript": "^5.0.0",
    "vite-plugin-pwa": "^1.3.0",
    "vitest": "^4.1.11",
    "workbox-build": "^7.4.1",
    "workbox-window": "^7.4.1"
  }
}
